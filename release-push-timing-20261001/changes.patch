+function fccPushPresentation(data) {
+ if(!data||typeof data!=='object')data={};
+ const locale=['sr','cnr'].includes(data.locale)?'hr':data.locale;
+ const copy=Object.hasOwn(FCC_PUSH_COPY,locale)?FCC_PUSH_COPY[locale]:FCC_PUSH_COPY.en;
+ let title='FCC Partner',body='Imaš novu obavijest u svojem radnom prostoru.';
+ if(data.schema===2) {
+  if(Object.hasOwn(copy.types,data.kind)){title='FCC · '+copy.types[data.kind][0];body=copy.types[data.kind][1];}
+  else if(data.kind==='summary'){
+   const counts=Object.entries(data.counts&&typeof data.counts==='object'?data.counts:{}).filter(([kind,n])=>Object.hasOwn(copy.types,kind)&&Number.isInteger(n)&&n>0&&n<=100);
+   const total=counts.reduce((n,item)=>n+item[1],0);
+   if(total>0&&total<=100){title=copy.summary;body=copy.total.replace('{n}',total)+' '+counts.slice(0,3).map(([kind,n])=>copy.types[kind][0]+': '+n).join('. ')+'. '+copy.open;}
+  }
+ }
+ // Only the server's explicit CC detail preference can enable personal CC text.
+ if(data.schema===2&&data.kind==='cc'&&typeof data.ccDetails==='string'&&data.ccDetails.length<=1000)body=data.ccDetails;
+ const options={body,icon:'/partner-assets/fcc-app-192.png',badge:'/partner-assets/fcc-app-192.png',tag:typeof data.tag==='string'?data.tag.slice(0,80):'fcc-partner',renotify:false,data:{url:fccNotificationPath(data.url)}};
+ if(data.schema===2){options.silent=data.sound===false;if(!options.silent)options.vibrate=[60];}
+ return {title,options};
