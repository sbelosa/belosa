{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fcc:curriculum:90:v1",
  "title": "FCC90 HR integration catalog",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "editorial_status": {
      "const": "finalized_for_integration"
    },
    "activation_status": {
      "const": "not_connected_to_live_program"
    },
    "language": {
      "const": "hr"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "core_labels": {
      "type": "object",
      "properties": {
        "Productivity": {
          "type": "string",
          "minLength": 1
        },
        "Retention": {
          "type": "string",
          "minLength": 1
        },
        "Recruitment": {
          "type": "string",
          "minLength": 1
        },
        "Development": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "Productivity",
        "Retention",
        "Recruitment",
        "Development"
      ],
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "integer",
            "minimum": 1
          },
          "to": {
            "type": "integer",
            "maximum": 90
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "title",
          "goal"
        ],
        "additionalProperties": false
      }
    },
    "levels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "level",
          "id",
          "label",
          "description",
          "min_completed",
          "window",
          "min_applied",
          "min_external",
          "min_cores",
          "min_mentoring",
          "cc_rule"
        ]
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "timezone",
        "total_steps",
        "cc",
        "existing_users",
        "sunday"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "coach_contract": {
      "type": "object",
      "required": [
        "purpose",
        "input_allowlist",
        "never_automatic",
        "output",
        "rules",
        "offline_fallback"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "use": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "url",
          "use"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 90,
      "maxItems": 90,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^fcc90_v1_0(?:0[1-9]|[1-8][0-9]|90)$"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "content_version": {
            "type": "integer",
            "minimum": 1
          },
          "language": {
            "const": "hr"
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "core": {
            "enum": [
              "Productivity",
              "Retention",
              "Recruitment",
              "Development"
            ]
          },
          "core_label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "why": {
            "type": "string",
            "minLength": 70
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 20
            }
          },
          "example": {
            "type": "string",
            "minLength": 40
          },
          "completion": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 30
              },
              "progress_units": {
                "const": 1
              },
              "requires_other_person_response": {
                "const": false
              },
              "requires_purchase": {
                "const": false
              },
              "requires_pro": {
                "const": false
              },
              "default_mode": {
                "enum": [
                  "applied",
                  "practice"
                ]
              },
              "practice_available": {
                "const": true
              },
              "external_event_eligible": {
                "type": "boolean"
              },
              "result_type_applied": {
                "enum": [
                  "planning",
                  "content",
                  "training",
                  "contact",
                  "recommendation",
                  "follow_up",
                  "onboarding",
                  "customer_checkin",
                  "invitation",
                  "coaching"
                ]
              },
              "result_type_practice": {
                "const": "training"
              },
              "evidence_fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "output_statuses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "self_check": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "criterion",
              "progress_units",
              "requires_other_person_response",
              "requires_purchase",
              "requires_pro",
              "default_mode",
              "practice_available",
              "external_event_eligible",
              "result_type_applied",
              "result_type_practice",
              "evidence_fields",
              "output_statuses",
              "self_check"
            ],
            "additionalProperties": false
          },
          "help": {
            "type": "object",
            "properties": {
              "if_no_opportunity": {
                "type": "string",
                "minLength": 40
              },
              "low_time": {
                "type": "string",
                "minLength": 1
              },
              "common_mistake": {
                "type": "string",
                "minLength": 1
              },
              "self_question": {
                "type": "string",
                "minLength": 1
              },
              "coach_brief": {
                "type": "string",
                "minLength": 80
              },
              "fallback_requires_paid_tool": {
                "const": false
              }
            },
            "required": [
              "if_no_opportunity",
              "low_time",
              "common_mistake",
              "self_question",
              "coach_brief",
              "fallback_requires_paid_tool"
            ],
            "additionalProperties": false
          },
          "levels": {
            "type": "object",
            "properties": {
              "1": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "adaptation": {
                    "type": "string",
                    "minLength": 20
                  },
                  "minutes": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 25
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 25
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "completion_addendum": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "adaptation",
                  "minutes",
                  "scope",
                  "completion_addendum"
                ],
                "additionalProperties": false
              },
              "2": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "adaptation": {
                    "type": "string",
                    "minLength": 20
                  },
                  "minutes": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 25
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 25
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "completion_addendum": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "adaptation",
                  "minutes",
                  "scope",
                  "completion_addendum"
                ],
                "additionalProperties": false
              },
              "3": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "adaptation": {
                    "type": "string",
                    "minLength": 20
                  },
                  "minutes": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 25
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 25
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "completion_addendum": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "adaptation",
                  "minutes",
                  "scope",
                  "completion_addendum"
                ],
                "additionalProperties": false
              },
              "4": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "adaptation": {
                    "type": "string",
                    "minLength": 20
                  },
                  "minutes": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 25
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 25
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "completion_addendum": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "adaptation",
                  "minutes",
                  "scope",
                  "completion_addendum"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "1",
              "2",
              "3",
              "4"
            ],
            "additionalProperties": false
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "video_binding": {
            "type": [
              "null",
              "string"
            ]
          },
          "text_is_complete_without_video": {
            "const": true
          },
          "private_default": {
            "const": true
          },
          "communication": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "message",
                  "public",
                  "note",
                  "instruction"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "situation": {
                "type": "string",
                "minLength": 1
              },
              "personal_experience": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "condition": {
                        "type": "string",
                        "minLength": 1
                      },
                      "message": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "condition",
                      "message"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "kind",
              "label",
              "situation",
              "personal_experience"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "position",
          "content_version",
          "language",
          "module",
          "core",
          "core_label",
          "kind",
          "title",
          "why",
          "steps",
          "example",
          "completion",
          "help",
          "levels",
          "resources",
          "video_binding",
          "text_is_complete_without_video",
          "private_default",
          "communication"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "editorial_status",
    "activation_status",
    "language",
    "title",
    "core_labels",
    "modules",
    "levels",
    "policy",
    "resources",
    "coach_contract",
    "sources",
    "tasks"
  ],
  "additionalProperties": false
}
